  if(a==='extra-next'){const events=ev(today).filter(e=>e.time>=clock&&!db.records('eventLog').some(l=>l.eventId===e.id&&l.date===today));showModal('¿Qué sigue?',events.length?events.map(e=>`<p><strong>${esc(e.time)}</strong> · ${esc(e.name)}</p>`).join(''):'<p>No tenés más eventos con hora pendientes para hoy.</p>');}
  if(a==='extra-free')showModal('Tengo un rato libre',`<form>${input('¿Cuántos minutos tenés?','minutes',15,'number','min="1" max="240" required')}<button class="button primary" type="submit">Ver ideas</button></form>`,f=>{const minutes=Number(f.get('minutes'));const suggestions=db.records('habit').filter(h=>scheduled(h,today)&&!db.records('log').some(l=>l.habitId===h.id&&l.date===today&&['done','skip'].includes(l.status))&&(h.type!=='time'||h.target<=minutes));showModal('A tu ritmo',suggestions.map(h=>`<p>${esc(h.name)} ${h.type==='time'?`· ${h.target} min`:''}</p>`).join('')||'<p>Podés descansar, leer unas páginas o anotar una idea.</p>');});
  if(a==='extra-close'){const summary=daySummary({habits:db.records('habit'),logs:db.records('log'),events:db.records('event'),eventLogs:db.records('eventLog'),readings:db.records('reading'),journals:db.records('journal')},today);showModal('Tu cierre del día',`<p>${esc(summary)}</p><h3>Mañana</h3>${ev(addDays(today,1)).map(e=>`<p>${esc(e.time||'Todo el día')} · ${esc(e.name)}</p>`).join('')||'<p>Sin eventos programados.</p>'}${btn('Escribir cómo me sentí','journal','','button primary')}`);}
- if(a==='extra-week'){const week=weekKeys(today),logs=db.records('log').filter(l=>week.includes(l.date)&&l.status==='done'),reads=db.records('reading').filter(r=>week.includes(r.date)),books=db.records('book').filter(b=>b.status==='finished');const medals=[];if(db.records('log').some(l=>l.status==='done'))medals.push('🌱 Tu primer paso');if(db.records('log').filter(l=>l.status==='done').length>=30)medals.push('🏅 30 hábitos completados');if(books.length>=10)medals.push('📚 10 libros terminados');showModal('Tu semana y tus logros',`<p>Esta semana registraste <strong>${logs.length} hábitos</strong> y <strong>${reads.reduce((n,r)=>n+Number(r.minutes),0)} minutos de lectura</strong>.</p><p>¡Bien por el tiempo que te dedicaste!</p>${medals.map(m=>`<p>${m}</p>`).join('')}`);}
+ if(a==='extra-week'){const week=weekKeys(today),logs=db.records('log').filter(l=>week.includes(l.date)&&l.status==='done'),reads=db.records('reading').filter(r=>week.includes(r.date)),c=catalog(),booksFinished=c.allowed?(c.finishedCount||0):db.records('book').filter(b=>b.status==='finished').length;const medals=[];if(db.records('log').some(l=>l.status==='done'))medals.push('🌱 Tu primer paso');if(db.records('log').filter(l=>l.status==='done').length>=30)medals.push('🏅 30 hábitos completados');if(booksFinished>=10)medals.push('📚 10 libros terminados');showModal('Tu semana y tus logros',`<p>Esta semana registraste <strong>${logs.length} hábitos</strong> y <strong>${reads.reduce((n,r)=>n+Number(r.minutes),0)} minutos de lectura</strong>.</p><p>¡Bien por el tiempo que te dedicaste!</p>${medals.map(m=>`<p>${m}</p>`).join('')}`);}
