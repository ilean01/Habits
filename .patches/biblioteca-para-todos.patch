 export function statsView(s){const books=s.data.books.filter(b=>!b.eliminado&&b.lista==='catalogo'),years=new Map(),genres=new Map(),authors=new Map();for(const r of s.data.finished){const y=String(r.fecha_fin||'').slice(0,4)||'Sin fecha';years.set(y,(years.get(y)||0)+1);}for(const b of books){genres.set(b.genero||'Sin género',(genres.get(b.genero||'Sin género')||0)+1);authors.set(b.autor||'Sin autor',(authors.get(b.autor||'Sin autor')||0)+1);}return `<h1>Estadísticas</h1>${chart('Libros terminados por año',[...years])}${chart('Géneros del catálogo',[...genres].sort((a,b)=>b[1]-a[1]).slice(0,20))}${chart('Autores más presentes',[...authors].sort((a,b)=>b[1]-a[1]).slice(0,20))}`;}
 export function configView(s){const c=s.config;return `<div class="lib-page-head"><div><h1>⚙ Configuración</h1><p>La configuración es privada para esta biblioteca.</p></div></div><form id="config-form"><div class="lib-config-grid"><section class="lib-config-section"><h3>🏷 Nombre</h3><label class="lib-field"><span>Nombre de la biblioteca</span><input class="lib-input" name="nombre_biblioteca" value="${esc(c.nombre_biblioteca)}"></label></section><section class="lib-config-section"><h3>🎨 Colores</h3>${color('Color principal','color_principal',c.color_principal)}${color('Fondo','color_fondo',c.color_fondo)}${color('Texto','color_texto',c.color_texto)}${color('Tarjetas','color_tarjeta',c.color_tarjeta)}</section><section class="lib-config-section"><h3>🔤 Tipografía</h3><label class="lib-field"><span>Fuente general</span><select class="lib-select" name="fuente">${['Georgia, serif','Arial, sans-serif','Verdana, sans-serif','Trebuchet MS, sans-serif','system-ui, sans-serif'].map(x=>`<option ${c.fuente===x?'selected':''}>${esc(x)}</option>`).join('')}</select></label><label class="lib-field"><span>Tamaño de texto</span><input class="lib-input" type="number" min="12" max="22" name="tamano_texto" value="${esc(c.tamano_texto)}"></label></section><section class="lib-config-section"><h3>📚 Catálogo</h3><label class="lib-field"><span>Vista predeterminada</span><select class="lib-select" name="vista_default"><option value="cuadricula" ${c.vista_default==='cuadricula'?'selected':''}>Cuadrícula</option><option value="lista" ${c.vista_default==='lista'?'selected':''}>Lista</option></select></label><label class="lib-field"><span>Libros por página</span><select class="lib-select" name="por_pagina">${['100','200','500','todos'].map(x=>`<option ${c.por_pagina===x?'selected':''}>${x}</option>`).join('')}</select></label><label class="lib-check"><input type="checkbox" name="mostrar_favoritos_catalogo" ${c.mostrar_favoritos_catalogo==='1'?'checked':''}> Mostrar estrella de favoritos</label></section><section class="lib-config-section"><h3>💾 Copias y exportación</h3><p class="lib-muted lib-small">Se crea un respaldo JSON privado por día y se conservan los últimos 10.</p><div class="lib-actions">${button('Descargar último respaldo','download-backup','','lib-button secondary')}${button('Descargar CSV','export-csv','','lib-button secondary')}${button('Exportar JSON ahora','export-json','','lib-button secondary')}</div></section></div><div class="lib-actions" style="margin-top:18px"><button type="submit" class="lib-button">Guardar configuración</button></div></form>${shareView(s)}`}
