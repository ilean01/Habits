  if(a==='scan-isbn'){const {BrowserMultiFormatReader}=await import('@zxing/browser');const reader=new BrowserMultiFormatReader();const video=document.createElement('video');video.style.maxWidth='100%';modal.append(video);let controls;const stop=()=>{controls?.stop();video.remove();};modal.addEventListener('close',stop,{once:true});controls=await reader.decodeFromVideoDevice(undefined,video,(result)=>{if(result){const input=modal.querySelector('[name=isbn]');if(input)input.value=u.cleanIsbn(result.getText());stop();}});return;}
