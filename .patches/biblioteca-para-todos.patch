+async function reload(){await loadSharing().catch(()=>{});s.data=await data.loadAll();s.covers=await data.signedCoverMap(s.data.books);s.config=u.configObject(s.data.config);s.perPage=s.config.por_pagina==='todos'?Math.max(1,s.data.books.length):Math.max(1,Number(s.config.por_pagina)||200);s.filterOptions={generos:u.unique(s.data.books.map(b=>b.genero)),codigos:u.unique(s.data.books.map(b=>b.codigo_p)),idiomas:u.unique(s.data.books.map(b=>b.idioma))};u.applyConfig(s.config);render();}
 function extraView(){if(s.view==='duplicados'){const groups=new Map();for(const b of s.data.books.filter(b=>!b.eliminado)){const key=u.cleanIsbn(b.isbn)||u.stripAccents(`${b.titulo}|${b.autor}`);groups.set(key,[...(groups.get(key)||[]),b]);}return `<h1>Posibles duplicados</h1><p>No se elimina ningún ejemplar automáticamente.</p>${[...groups.values()].filter(g=>g.length>1).map(g=>`<section class="lib-panel">${g.map(b=>button(u.esc(b.titulo)+' · '+u.esc(b.codigo_p||'')+' '+u.esc(b.item||''),'book',b.id)).join('')}</section>`).join('')||'<p>Sin coincidencias.</p>'}`;}if(s.view==='recomendador'){const available=s.data.books.filter(b=>!b.eliminado&&b.lista==='catalogo'&&b.estado_lectura==='no_leido'&&!s.data.loans.some(l=>l.libro_id===b.id&&l.activo));const recommended=available.sort((a,b)=>Number(b.proxima_lectura)-Number(a.proxima_lectura)||Number(b.favorito)-Number(a.favorito)||Number(a.paginas||9999)-Number(b.paginas||9999)).slice(0,12);return `<h1>Tu próxima lectura</h1><p>Libros disponibles sin leer, priorizando tu lista, favoritos y lecturas breves.</p>${recommended.map(b=>`<section class="lib-panel"><h3>${u.esc(b.titulo)}</h3><p>${u.esc(b.autor)} · ${b.paginas||'—'} páginas</p>${button('Ver ficha','book',b.id)}</section>`).join('')||'<p>No hay libros pendientes disponibles.</p>'}`;}return renderCurrentView(s);}
-function render(){root.innerHTML=headerView(s)+`<main class="lib-main"><div class="lib-actions">${button('Duplicados','duplicates')}${button('Recomendador','recommend')}${canWrite?button('Buscar por ISBN','isbn'):''}</div>${!canWrite?'<p class="lib-panel">Acceso de lectura. Solo las personas con permiso de edición pueden modificar esta biblioteca.</p>':''}${extraView()}</main>`;const config=root.querySelector('#config-form');if(config)config.onsubmit=async e=>{e.preventDefault();try{requireWrite();const f=new FormData(config);await data.saveConfig({...Object.fromEntries(f),mostrar_favoritos_catalogo:f.has('mostrar_favoritos_catalogo')?'1':'0'});await reload();toast('Configuración guardada.');}catch(error){toast(error.message);}};}
+function render(){root.innerHTML=headerView(s)+`<main class="lib-main"><div class="lib-actions">${button('Duplicados','duplicates')}${button('Recomendador','recommend')}${canWrite?button('Buscar por ISBN','isbn'):''}</div>${!canWrite?'<p class="lib-panel">Acceso de lectura. Solo las personas con permiso de edición pueden modificar esta biblioteca.</p>':''}${extraView()}</main>`;const share=root.querySelector('#share-form');if(share)share.onsubmit=async e=>{e.preventDefault();const f=new FormData(share);const r=await supabase.rpc('biblioteca_invitar',{p_email:String(f.get('email')||''),p_rol:String(f.get('rol')||'reader')});if(r.error){toast(r.error.message);return;}await loadSharing();render();toast('Listo: ahora esa cuenta puede abrir tu biblioteca.');};const config=root.querySelector('#config-form');if(config)config.onsubmit=async e=>{e.preventDefault();try{requireWrite();const f=new FormData(config);await data.saveConfig({...Object.fromEntries(f),mostrar_favoritos_catalogo:f.has('mostrar_favoritos_catalogo')?'1':'0'});await reload();toast('Configuración guardada.');}catch(error){toast(error.message);}};}
 function requireWrite(){if(!canWrite)throw new Error('Tu permiso es de lectura. Pedí permiso de edición a la persona responsable.');}
 function editBook(id,preset={}){requireWrite();const b={...(s.book(id)||{}),...preset};const names={titulo:'Título',autor:'Autor',codigo_p:'Código de propietario',item:'Número de ejemplar',dewey:'Dewey',genero:'Género',subdivision:'Subdivisión',editorial:'Editorial',paginas:'Páginas',isbn:'ISBN',idioma:'Idioma',relacionados:'Libros relacionados'};dialog(id?'Editar libro':'Agregar libro',Object.entries(names).map(([k,label])=>field(k,label,b[k],['item','paginas'].includes(k)?'number':'text',k==='titulo'?'required':(['item','paginas'].includes(k)?'min="0"':''))).join('')+`<label class="lib-field">Lista<select name="lista" class="lib-select"><option value="catalogo">Catálogo</option><option value="deseos" ${b.lista==='deseos'?'selected':''}>Deseos</option></select></label>`+text('descripcion','Sinopsis',b.descripcion)+text('observaciones','Observaciones',b.observaciones)+text('dedicatoria','Dedicatoria',b.dedicatoria)+field('rating','Valoración (0 a 5)',b.rating||0,'number','min="0" max="5"')+`<label><input type="checkbox" name="autografiado" ${b.autografiado?'checked':''}> Autografiado</label>`,async f=>{const v=Object.fromEntries(f);v.paginas=v.paginas?Number(v.paginas):null;v.item=v.item?Number(v.item):null;v.rating=Number(v.rating);v.autografiado=f.has('autografiado');v.dewey_orden=u.deweyNumber(v.dewey);if(id)await data.updateBook(id,v);else await data.insertBook({...v,estado_lectura:'no_leido',fecha_agregado:u.today(),portada:b.portada_url||null});});}
