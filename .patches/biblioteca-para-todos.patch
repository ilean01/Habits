 async function boot(){try{const access=await sessionAndAccess();s.user=access.user;if(!access.allowed){root.innerHTML='<main class="lib-main"><div class="lib-panel"><h2>Biblioteca privada</h2><p>Tu cuenta no tiene acceso a esta biblioteca.</p><a href="./" class="lib-button">Volver a Habits</a></div></main>';return;}await ensureConfig();await reload();await createDailyBackup(s.data).catch(()=>{});const cover=new URLSearchParams(location.search).get('cover');if(cover){const b=s.book(Number(cover));if(b&&canWrite)editBook(b.id);}}catch(error){root.innerHTML=`<main class="lib-main"><div class="lib-panel"><h2>No se pudo abrir la biblioteca</h2><p>${u.esc(error.message)}</p><a href="./" class="lib-button">Volver a Habits</a></div></main>`;}}
