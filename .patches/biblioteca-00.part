From ea36c885ad7e4cbc89a0d8dd1f5f465d19361b5b Mon Sep 17 00:00:00 2001
From: "Claude (para Ileana)" <ilean01@users.noreply.github.com>
Date: Wed, 23 Sep 2026 01:58:05 +0000
Subject: [PATCH] =?UTF-8?q?Biblioteca=20para=20todas=20las=20cuentas;=20la?=
 =?UTF-8?q?=20de=20mam=C3=A1=20solo=20por=20invitaci=C3=B3n,=20con=20selec?=
 =?UTF-8?q?tor=20y=20pantalla=20para=20compartir?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 docs/REQUISITOS.md                            |   3 +-
 src/biblioteca-main.js                        |  10 +-
 src/biblioteca.css                            |   2 +
 src/biblioteca/views.js                       |  10 +-
 .../20260923100000_biblioteca_para_todos.sql  | 127 ++++++++++++++++++
 tests/library-sharing.test.js                 |  72 ++++++++++
 6 files changed, 218 insertions(+), 6 deletions(-)
 create mode 100644 supabase/migrations/20260923100000_biblioteca_para_todos.sql
 create mode 100644 tests/library-sharing.test.js

diff --git a/docs/REQUISITOS.md b/docs/REQUISITOS.md
index 8725192..3243a08 100644
--- a/docs/REQUISITOS.md
+++ b/docs/REQUISITOS.md
@@ -93,7 +93,8 @@ Lista oficial de lo pedido para la app. Cada cambio se valida contra esta lista.
 - ✅ Préstamos con persona, fecha prevista, devolución, perdido e historial por persona.
 - ✅ Deseos, Leer después con "Empezar a leer", papelera, revisión, duplicados.
 - ✅ ISBN, cámara, datos externos, portadas, etiquetas PDF, CSV/JSON, respaldos, estadísticas.
-- ✅ Miembros con rol lector/editor, RLS en tablas y archivos.
+- ✅ Cada cuenta tiene su propia biblioteca (vacía al empezar) con todas las funciones.
+- ✅ La biblioteca de mamá solo la ven las cuentas que su dueña invite por correo (solo ver o editar); se puede quitar el acceso en cualquier momento. RLS en tablas y archivos.
 - ✅ Habits muestra la lectura actual del catálogo y guarda página/final con `biblioteca_transition`.
 - 🟡 QR de portadas: pide sesión (el original usaba token temporal).
 - 🟡 Recomendador por reglas simples. 🟡 Configuración tipográfica sin cotejar.
diff --git a/src/biblioteca-main.js b/src/biblioteca-main.js
index dacd8d0..ab3683e 100644
--- a/src/biblioteca-main.js
+++ b/src/biblioteca-main.js
@@ -14,15 +14,16 @@ s.filteredBooks=list=>s.data.books.filter(b=>!b.eliminado&&b.lista===list&&u.mat
 s.labelFilteredBooks=()=>s.data.books.filter(b=>!b.eliminado&&b.lista==='catalogo'&&u.matchesSearch(b,s.labelFilters.q)&&(!s.labelFilters.codigo_p||b.codigo_p===s.labelFilters.codigo_p)&&(!s.labelFilters.genero||b.genero===s.labelFilters.genero)&&String(b.dewey||'').startsWith(s.labelFilters.dewey||''));
 function toast(message){const t=document.querySelector('#library-toast');t.textContent=message;t.style.display='block';clearTimeout(toast.timer);toast.timer=setTimeout(()=>t.style.display='none',6500);}
 function dialog(title,body,save){modal.innerHTML=`<div class="lib-page-head"><h2>${u.esc(title)}</h2>${button('Cerrar','close')}</div>${save?'<form>':''}${body}${save?'<button class="lib-button" type="submit">Guardar</button></form>':''}`;if(!modal.open)modal.showModal();if(save)modal.querySelector('form').onsubmit=async e=>{e.preventDefault();const b=e.submitter;b.disabled=true;try{await save(new FormData(e.target));modal.close();await reload();toast('Guardado.');}catch(error){toast(error.message);}finally{b.disabled=false;}};}
-async function reload(){s.data=await data.loadAll();s.covers=await data.signedCoverMap(s.data.books);s.config=u.configObject(s.data.config);s.perPage=s.config.por_pagina==='todos'?Math.max(1,s.data.books.length):Math.max(1,Number(s.config.por_pagina)||200);s.filterOptions={generos:u.unique(s.data.books.map(b=>b.genero)),codigos:u.unique(s.data.books.map(b=>b.codigo_p)),idiomas:u.unique(s.data.books.map(b=>b.idioma))};u.applyConfig(s.config);render();}
+async function loadSharing(){const l=await supabase.rpc('biblioteca_disponibles');s.libraries=l.error?[]:l.data||[];const active=s.libraries.find(x=>x.activa);if(!active||active.propia){const m=await supabase.rpc('biblioteca_miembros');s.members=m.error?[]:m.data||[];}else s.members=[];}
+async function reload(){await loadSharing().catch(()=>{});s.data=await data.loadAll();s.covers=await data.signedCoverMap(s.data.books);s.config=u.configObject(s.data.config);s.perPage=s.config.por_pagina==='todos'?Math.max(1,s.data.books.length):Math.max(1,Number(s.config.por_pagina)||200);s.filterOptions={generos:u.unique(s.data.books.map(b=>b.genero)),codigos:u.unique(s.data.books.map(b=>b.codigo_p)),idiomas:u.unique(s.data.books.map(b=>b.idioma))};u.applyConfig(s.config);render();}
 function extraView(){if(s.view==='duplicados'){const groups=new Map();for(const b of s.data.books.filter(b=>!b.eliminado)){const key=u.cleanIsbn(b.isbn)||u.stripAccents(`${b.titulo}|${b.autor}`);groups.set(key,[...(groups.get(key)||[]),b]);}return `<h1>Posibles duplicados</h1><p>No se elimina ningún ejemplar automáticamente.</p>${[...groups.values()].filter(g=>g.length>1).map(g=>`<section class="lib-panel">${g.map(b=>button(u.esc(b.titulo)+' · '+u.esc(b.codigo_p||'')+' '+u.esc(b.item||''),'book',b.id)).join('')}</section>`).join('')||'<p>Sin coincidencias.</p>'}`;}if(s.view==='recomendador'){const available=s.data.books.filter(b=>!b.eliminado&&b.lista==='catalogo'&&b.estado_lectura==='no_leido'&&!s.data.loans.some(l=>l.libro_id===b.id&&l.activo));const recommended=available.sort((a,b)=>Number(b.proxima_lectura)-Number(a.proxima_lectura)||Number(b.favorito)-Number(a.favorito)||Number(a.paginas||9999)-Number(b.paginas||9999)).slice(0,12);return `<h1>Tu próxima lectura</h1><p>Libros disponibles sin leer, priorizando tu lista, favoritos y lecturas breves.</p>${recommended.map(b=>`<section class="lib-panel"><h3>${u.esc(b.titulo)}</h3><p>${u.esc(b.autor)} · ${b.paginas||'—'} páginas</p>${button('Ver ficha','book',b.id)}</section>`).join('')||'<p>No hay libros pendientes disponibles.</p>'}`;}return renderCurrentView(s);}
-function render(){root.innerHTML=headerView(s)+`<main class="lib-main"><div class="lib-actions">${button('Duplicados','duplicates')}${button('Recomendador','recommend')}${canWrite?button('Buscar por ISBN','isbn'):''}</div>${!canWrite?'<p class="lib-panel">Acceso de lectura. Solo las personas con permiso de edición pueden modificar esta biblioteca.</p>':''}${extraView()}</main>`;const config=root.querySelector('#config-form');if(config)config.onsubmit=async e=>{e.preventDefault();try{requireWrite();const f=new FormData(config);await data.saveConfig({...Object.fromEntries(f),mostrar_favoritos_catalogo:f.has('mostrar_favoritos_catalogo')?'1':'0'});await reload();toast('Configuración guardada.');}catch(error){toast(error.message);}};}
+function render(){root.innerHTML=headerView(s)+`<main class="lib-main"><div class="lib-actions">${button('Duplicados','duplicates')}${button('Recomendador','recommend')}${canWrite?button('Buscar por ISBN','isbn'):''}</div>${!canWrite?'<p class="lib-panel">Acceso de lectura. Solo las personas con permiso de edición pueden modificar esta biblioteca.</p>':''}${extraView()}</main>`;const share=root.querySelector('#share-form');if(share)share.onsubmit=async e=>{e.preventDefault();const f=new FormData(share);const r=await supabase.rpc('biblioteca_invitar',{p_email:String(f.get('email')||''),p_rol:String(f.get('rol')||'reader')});if(r.error){toast(r.error.message);return;}await loadSharing();render();toast('Listo: ahora esa cuenta puede abrir tu biblioteca.');};const config=root.querySelector('#config-form');if(config)config.onsubmit=async e=>{e.preventDefault();try{requireWrite();const f=new FormData(config);await data.saveConfig({...Object.fromEntries(f),mostrar_favoritos_catalogo:f.has('mostrar_favoritos_catalogo')?'1':'0'});await reload();toast('Configuración guardada.');}catch(error){toast(error.message);}};}
 function requireWrite(){if(!canWrite)throw new Error('Tu permiso es de lectura. Pedí permiso de edición a la persona responsable.');}
 function editBook(id,preset={}){requireWrite();const b={...(s.book(id)||{}),...preset};const names={titulo:'Título',autor:'Autor',codigo_p:'Código de propietario',item:'Número de ejemplar',dewey:'Dewey',genero:'Género',subdivision:'Subdivisión',editorial:'Editorial',paginas:'Páginas',isbn:'ISBN',idioma:'Idioma',relacionados:'Libros relacionados'};dialog(id?'Editar libro':'Agregar libro',Object.entries(names).map(([k,label])=>field(k,label,b[k],['item','paginas'].includes(k)?'number':'text',k==='titulo'?'required':(['item','paginas'].includes(k)?'min="0"':''))).join('')+`<label class="lib-field">Lista<select name="lista" class="lib-select"><option value="catalogo">Catálogo</option><option value="deseos" ${b.lista==='deseos'?'selected':''}>Deseos</option></select></label>`+text('descripcion','Sinopsis',b.descripcion)+text('observaciones','Observaciones',b.observaciones)+text('dedicatoria','Dedicatoria',b.dedicatoria)+field('rating','Valoración (0 a 5)',b.rating||0,'number','min="0" max="5"')+`<label><input type="checkbox" name="autografiado" ${b.autografiado?'checked':''}> Autografiado</label>`,async f=>{const v=Object.fromEntries(f);v.paginas=v.paginas?Number(v.paginas):null;v.item=v.item?Number(v.item):null;v.rating=Number(v.rating);v.autografiado=f.has('autografiado');v.dewey_orden=u.deweyNumber(v.dewey);if(id)await data.updateBook(id,v);else await data.insertBook({...v,estado_lectura:'no_leido',fecha_agregado:u.today(),portada:b.portada_url||null});});}
 function bookDetail(id){const b=s.book(id);if(!b)return;dialog(b.titulo,`${s.covers.has(b.id)?`<img src="${u.esc(s.covers.get(b.id))}" alt="Portada" style="max-width:180px">`:''}<p>${u.esc(b.autor)}</p><p>${u.esc(b.descripcion||'Sin sinopsis')}</p><dl>${Object.entries(b).filter(([k,v])=>!['id','owner_id','portada','descripcion'].includes(k)&&v!==null).map(([k,v])=>`<dt>${u.esc(k)}</dt><dd>${u.esc(v)}</dd>`).join('')}</dl><div class="lib-actions">${canWrite?['edit-book','favorite','start-book','add-next-book','cover','remove-cover','internet','phone-cover','trash-book'].map((a,i)=>button(['Editar','Favorito ☆','Empezar lectura','Leer después','Subir / cambiar portada','Quitar portada','Buscar datos y portadas','Cargar desde celular','Enviar a papelera'][i],a,id)).join(''):''}</div><h3>Historial de lectura</h3>${s.data.readings.filter(r=>r.libro_id===id).map(r=>`<p>${u.esc(r.fecha)} · página ${r.pagina} · ${r.paginas_leidas} páginas leídas</p>`).join('')||'<p>Sin registros.</p>'}`);}
 function selectBook(title,callback){requireWrite();dialog(title,`<label class="lib-field">Libro<select class="lib-select" name="book">${s.data.books.filter(b=>!b.eliminado&&b.lista==='catalogo').map(b=>`<option value="${b.id}">${u.esc(b.titulo)}</option>`).join('')}</select></label>`,f=>callback(Number(f.get('book'))));}
 async function transition(kind,id,payload={}){requireWrite();const {error}=await supabase.rpc('biblioteca_transition',{p_action:kind,p_book:id,p_data:payload});if(error)throw error;}
