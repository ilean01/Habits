 export function labelsView(s){const books=s.labelFilteredBooks(),selected=s.selectedLabels;return `<div class="lib-page-head"><div><h1>🏷 Etiquetas de lomo</h1><p>Elegí solo los libros que quieras imprimir.</p></div><div class="lib-actions">${button('Imprimir hoja','print-labels','','lib-button')}</div></div><section class="lib-panel"><div class="lib-label-toolbar"><input class="lib-input" id="label-q" value="${esc(s.labelFilters.q)}" placeholder="Título, autor, Dewey, ISBN…"><select class="lib-select" id="label-owner"><option value="">Propietario: todos</option>${s.filterOptions.codigos.map(v=>`<option ${s.labelFilters.codigo_p===v?'selected':''}>${esc(v)}</option>`).join('')}</select><input class="lib-input" id="label-dewey" value="${esc(s.labelFilters.dewey)}" placeholder="Dewey empieza con"><select class="lib-select" id="label-genre"><option value="">Género: todos</option>${s.filterOptions.generos.map(v=>`<option ${s.labelFilters.genero===v?'selected':''}>${esc(v)}</option>`).join('')}</select></div><div class="lib-actions" style="margin-bottom:12px">${button('Aplicar filtros','label-apply','','lib-button small')}${button('Seleccionar visibles','label-select-visible','','lib-button secondary small')}${button('Quitar visibles','label-unselect-visible','','lib-button secondary small')}${button('Seleccionar todos','label-select-all','','lib-button secondary small')}${button('Limpiar','label-clear','','lib-button secondary small')}<span class="lib-muted">${books.length} visibles · ${selected.size} seleccionados</span></div><div class="lib-label-list">${books.map(b=>`<label class="lib-label-choice"><input type="checkbox" data-label-id="${b.id}" ${selected.has(b.id)?'checked':''}><span><strong>${esc(deweyFmt(b.dewey)||'SIN')} · ${esc(b.titulo)}</strong><br><small>${esc(b.autor||'')} ${b.codigo_p?`· ${esc(b.codigo_p)}-${esc(b.item||'')}`:''}</small></span></label>`).join('')}</div></section><section class="lib-panel" style="margin-top:18px"><h2>Vista de impresión</h2><div class="lib-print-sheet">${s.data.books.filter(b=>selected.has(b.id)).map(b=>`<div class="lib-spine-label"><strong>${esc(deweyFmt(b.dewey)||'SIN')}</strong><span>${esc(cutterAuthor(b.autor))}</span><small>${esc(b.codigo_p||'')}${b.item?`-${b.item}`:''}</small></div>`).join('')||'<p class="lib-muted">Seleccioná libros para ver las etiquetas.</p>'}</div></section>`}
 
-export function configView(s){const c=s.config;return `<div class="lib-page-head"><div><h1>⚙ Configuración</h1><p>La configuración es privada para esta biblioteca.</p></div></div><form id="config-form"><div class="lib-config-grid"><section class="lib-config-section"><h3>🏷 Nombre</h3><label class="lib-field"><span>Nombre de la biblioteca</span><input class="lib-input" name="nombre_biblioteca" value="${esc(c.nombre_biblioteca)}"></label></section><section class="lib-config-section"><h3>🎨 Colores</h3>${color('Color principal','color_principal',c.color_principal)}${color('Fondo','color_fondo',c.color_fondo)}${color('Texto','color_texto',c.color_texto)}${color('Tarjetas','color_tarjeta',c.color_tarjeta)}</section><section class="lib-config-section"><h3>🔤 Tipografía</h3><label class="lib-field"><span>Fuente general</span><select class="lib-select" name="fuente">${['Georgia, serif','Arial, sans-serif','Verdana, sans-serif','Trebuchet MS, sans-serif','system-ui, sans-serif'].map(x=>`<option ${c.fuente===x?'selected':''}>${esc(x)}</option>`).join('')}</select></label><label class="lib-field"><span>Tamaño de texto</span><input class="lib-input" type="number" min="12" max="22" name="tamano_texto" value="${esc(c.tamano_texto)}"></label></section><section class="lib-config-section"><h3>📚 Catálogo</h3><label class="lib-field"><span>Vista predeterminada</span><select class="lib-select" name="vista_default"><option value="cuadricula" ${c.vista_default==='cuadricula'?'selected':''}>Cuadrícula</option><option value="lista" ${c.vista_default==='lista'?'selected':''}>Lista</option></select></label><label class="lib-field"><span>Libros por página</span><select class="lib-select" name="por_pagina">${['100','200','500','todos'].map(x=>`<option ${c.por_pagina===x?'selected':''}>${x}</option>`).join('')}</select></label><label class="lib-check"><input type="checkbox" name="mostrar_favoritos_catalogo" ${c.mostrar_favoritos_catalogo==='1'?'checked':''}> Mostrar estrella de favoritos</label></section><section class="lib-config-section"><h3>💾 Copias y exportación</h3><p class="lib-muted lib-small">Se crea un respaldo JSON privado por día y se conservan los últimos 10.</p><div class="lib-actions">${button('Descargar último respaldo','download-backup','','lib-button secondary')}${button('Descargar CSV','export-csv','','lib-button secondary')}${button('Exportar JSON ahora','export-json','','lib-button secondary')}</div></section></div><div class="lib-actions" style="margin-top:18px"><button type="submit" class="lib-button">Guardar configuración</button></div></form>`}
+export function configView(s){const c=s.config;return `<div class="lib-page-head"><div><h1>⚙ Configuración</h1><p>La configuración es privada para esta biblioteca.</p></div></div><form id="config-form"><div class="lib-config-grid"><section class="lib-config-section"><h3>🏷 Nombre</h3><label class="lib-field"><span>Nombre de la biblioteca</span><input class="lib-input" name="nombre_biblioteca" value="${esc(c.nombre_biblioteca)}"></label></section><section class="lib-config-section"><h3>🎨 Colores</h3>${color('Color principal','color_principal',c.color_principal)}${color('Fondo','color_fondo',c.color_fondo)}${color('Texto','color_texto',c.color_texto)}${color('Tarjetas','color_tarjeta',c.color_tarjeta)}</section><section class="lib-config-section"><h3>🔤 Tipografía</h3><label class="lib-field"><span>Fuente general</span><select class="lib-select" name="fuente">${['Georgia, serif','Arial, sans-serif','Verdana, sans-serif','Trebuchet MS, sans-serif','system-ui, sans-serif'].map(x=>`<option ${c.fuente===x?'selected':''}>${esc(x)}</option>`).join('')}</select></label><label class="lib-field"><span>Tamaño de texto</span><input class="lib-input" type="number" min="12" max="22" name="tamano_texto" value="${esc(c.tamano_texto)}"></label></section><section class="lib-config-section"><h3>📚 Catálogo</h3><label class="lib-field"><span>Vista predeterminada</span><select class="lib-select" name="vista_default"><option value="cuadricula" ${c.vista_default==='cuadricula'?'selected':''}>Cuadrícula</option><option value="lista" ${c.vista_default==='lista'?'selected':''}>Lista</option></select></label><label class="lib-field"><span>Libros por página</span><select class="lib-select" name="por_pagina">${['100','200','500','todos'].map(x=>`<option ${c.por_pagina===x?'selected':''}>${x}</option>`).join('')}</select></label><label class="lib-check"><input type="checkbox" name="mostrar_favoritos_catalogo" ${c.mostrar_favoritos_catalogo==='1'?'checked':''}> Mostrar estrella de favoritos</label></section><section class="lib-config-section"><h3>💾 Copias y exportación</h3><p class="lib-muted lib-small">Se crea un respaldo JSON privado por día y se conservan los últimos 10.</p><div class="lib-actions">${button('Descargar último respaldo','download-backup','','lib-button secondary')}${button('Descargar CSV','export-csv','','lib-button secondary')}${button('Exportar JSON ahora','export-json','','lib-button secondary')}</div></section></div><div class="lib-actions" style="margin-top:18px"><button type="submit" class="lib-button">Guardar configuración</button></div></form>${shareView(s)}`}
 function color(label,name,value){return `<label class="lib-field"><span>${label}</span><input class="lib-input" type="color" name="${name}" value="${esc(value)}"></label>`}
 
 export function personHistoryView(s,person){const loans=s.data.loans.filter(l=>l.persona===person).sort((a,b)=>String(b.fecha_prestamo).localeCompare(String(a.fecha_prestamo)));return `<div class="lib-page-head"><div><h1>👤 Historial de préstamos: ${esc(person)}</h1></div>${button('← Volver a préstamos','view','data-view="prestamos"','lib-button secondary')}</div><section class="lib-panel"><div class="lib-table-wrap"><table class="lib-table"><thead><tr><th>Libro</th><th>Prestado</th><th>Previsto</th><th>Devuelto</th><th>Estado</th></tr></thead><tbody>${loans.map(l=>`<tr><td>${esc(s.book(l.libro_id)?.titulo||'Libro eliminado')}</td><td>${fmtDate(l.fecha_prestamo)}</td><td>${fmtDate(l.fecha_devolucion_prevista)}</td><td>${fmtDate(l.fecha_devuelto)}</td><td>${esc(l.estado||'')}</td></tr>`).join('')||'<tr><td colspan="5">Sin préstamos registrados.</td></tr>'}</tbody></table></div></section>`}
 
 export function renderCurrentView(s){if(s.personHistory)return personHistoryView(s,s.personHistory);if(s.view==='catalogo')return catalogView(s,'catalogo');if(s.view==='deseos')return catalogView(s,'deseos');if(s.view==='lecturas')return readingsView(s);if(s.view==='prestamos')return loansView(s);if(s.view==='proximas')return nextReadsView(s);if(s.view==='revisar')return reviewView(s);if(s.view==='estadisticas')return statsView(s);if(s.view==='etiquetas')return labelsView(s);if(s.view==='papelera')return trashView(s);return configView(s)}
+
+// Compartir: la dueña elige quién puede ver su biblioteca. Quien no está invitado solo ve la suya.
+export function shareView(s){const active=(s.libraries||[]).find(l=>l.activa);
