diff --git a/src/style.css b/src/style.css
--- a/src/style.css
+++ b/src/style.css
@@ -20,3 +20,4 @@
 @media(max-width:760px){.mobile-nav button{min-width:0;flex:1}.mobile-nav button span{font-size:9px}}
 .icon-picker{display:flex;flex-wrap:wrap;gap:6px;grid-column:1/-1}.icon-picker label{display:block}.icon-picker input{position:absolute;opacity:0;width:1px;height:1px}.icon-picker span{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);border-radius:10px}.icon-picker input:checked+span{background:var(--soft);border:2px solid var(--green)}.icon-picker input:focus-visible+span{outline:3px solid var(--accent)}
 .week-agenda{display:grid;grid-template-columns:repeat(7,minmax(150px,1fr));overflow-x:auto;gap:12px}.week-agenda>section{padding:12px;background:var(--panel);border:1px solid var(--line);border-radius:12px}.week-agenda h3{font-size:13px}
+@media(max-width:650px){.icon-button{min-width:44px;min-height:44px}.event-card .icon-button,.habit-top .icon-button{width:44px;height:44px}.text-button{min-height:44px}.mobile-nav button{min-height:52px}.calendar-events small{font-size:9px}}
