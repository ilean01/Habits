 try{const access=await sessionAndAccess();if(!access.user){root.innerHTML='<main class="lib-main"><h1>Tu biblioteca privada</h1><p>Iniciá sesión en Habits para continuar.</p><a href="./">Ir a Habits</a></main>';}else if(!access.allowed){root.innerHTML='<main class="lib-main"><h1>Biblioteca con acceso restringido</h1><p>Esta cuenta no está autorizada. Tus hábitos, diario y calendario siguen disponibles.</p><a href="./">Volver a Habits</a></main>';}else{s.user=access.user;await ensureConfig();await reload();s.viewMode=s.config.vista_default||'cuadricula';render();if(canWrite)createDailyBackup(s.data).catch(()=>toast('No se pudo crear el respaldo diario. Podés exportar JSON desde Configuración.'));const bookId=Number(new URL(location.href).searchParams.get('cover'));if(bookId&&s.book(bookId)&&canWrite)await action('cover',{dataset:{id:bookId}});}}catch(error){root.innerHTML=`<main class="lib-main"><h1>No se pudo abrir la biblioteca</h1><p>${u.esc(error.message)}</p><p>Revisá la conexión y que las migraciones de Biblioteca estén aplicadas.</p><a href="./">Volver a Habits</a></main>`;}
