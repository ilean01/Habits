+async function action(a,el){const id=Number(el.dataset.id),b=s.book(id);if(a==='close'){modal.close();return;}if(a==='lib-own'){const r=await supabase.rpc('biblioteca_elegir',{p_owner:s.user.id});if(r.error)throw r.error;location.reload();return;}if(a==='share-leave'){if(!confirm('¿Salir de esta biblioteca compartida? Vas a dejar de verla hasta que te vuelvan a invitar.'))return;const r=await supabase.rpc('biblioteca_salir',{p_owner:el.dataset.owner});if(r.error)throw r.error;location.reload();return;}if(a==='share-remove'){if(!confirm(`¿Quitarle el acceso a ${el.dataset.email}? Deja de ver tu biblioteca al instante.`))return;const r=await supabase.rpc('biblioteca_quitar_miembro',{p_user:el.dataset.user});if(r.error)throw r.error;await loadSharing();render();toast('Acceso quitado.');return;}if(a==='view'){s.view=el.dataset.view;s.personHistory=null;s.page=1;render();return;}if(a==='book'){bookDetail(id);return;}if(a==='duplicates'||a==='recommend'){s.view=a==='duplicates'?'duplicados':'recomendador';s.personHistory=null;render();return;}if(a==='person-history'){s.personHistory=el.dataset.person;render();return;}if(a==='apply-filters'){for(const [key,node] of Object.entries({q:'catalog-q',genero:'filter-genero',codigo_p:'filter-codigo',idioma:'filter-idioma',estado_lectura:'filter-estado'}))s.filters[key]=document.getElementById(node).value;s.page=1;render();return;}if(a==='clear-filters'){s.filters={q:'',genero:'',codigo_p:'',idioma:'',estado_lectura:'',favorito:false};s.page=1;render();return;}if(a==='toggle-favorites'){s.filters.favorito=!s.filters.favorito;render();return;}if(a==='toggle-view-mode'){s.viewMode=s.viewMode==='lista'?'cuadricula':'lista';render();return;}if(a==='page'){s.page=Number(el.dataset.page);render();return;}if(a==='review-filter'){s.reviewKey=el.dataset.key;render();return;}
 if(a.startsWith('label-')){const visible=s.labelFilteredBooks();if(a==='label-apply'){for(const [k,node] of Object.entries({q:'label-q',codigo_p:'label-owner',genero:'label-genre',dewey:'label-dewey'}))s.labelFilters[k]=document.getElementById(node).value;}if(a==='label-select-visible')visible.forEach(b=>s.selectedLabels.add(b.id));if(a==='label-unselect-visible')visible.forEach(b=>s.selectedLabels.delete(b.id));if(a==='label-select-all')s.data.books.filter(b=>!b.eliminado&&b.lista==='catalogo').forEach(b=>s.selectedLabels.add(b.id));if(a==='label-clear')s.selectedLabels.clear();render();return;}
 if(a==='print-labels'){const books=s.data.books.filter(b=>s.selectedLabels.has(b.id));if(!books.length)throw new Error('Seleccioná al menos un libro.');const {jsPDF}=await import('jspdf');const pdf=new jsPDF();books.forEach((b,i)=>{if(i&&i%60===0)pdf.addPage();const n=i%60,x=10+(n%6)*32,y=10+Math.floor(n/6)*27;pdf.rect(x,y,30,25);pdf.setFontSize(10);pdf.text([u.deweyFmt(b.dewey)||'SIN',u.cutterAuthor(b.autor),`${b.codigo_p||''}-${b.item||''}`],x+15,y+7,{align:'center',maxWidth:28});});pdf.save('etiquetas.pdf');return;}
 if(a==='export-json'){u.downloadBlob(`biblioteca-${u.today()}.json`,JSON.stringify({version:18,...s.data},null,2),'application/json');return;}if(a==='export-csv'){u.downloadBlob('biblioteca.csv',u.csvText(s.data.books,Object.keys(s.data.books[0]||{titulo:''})),'text/csv');return;}if(a==='download-backup'){const backup=await latestBackup();if(!backup)throw new Error('Todavía no hay respaldos. Podés exportar JSON ahora.');u.downloadBlob(backup.name,backup.blob);return;}
