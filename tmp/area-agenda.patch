diff --git a/src/main.js b/src/main.js
index f88f538..1d6bc05 100644
--- a/src/main.js
+++ b/src/main.js
@@ -35,7 +35,9 @@ function eventCard(e,d){e=eventOnDate(e,d);const a=area(e.area),done=rec('eventL
 function currentReading(){const c=catalog();if(c.allowed){const b=c.reading[0];return b?{id:'lib:'+b.id,title:b.titulo,author:b.autor,page:b.pagina_actual||0,pages:b.paginas,more:c.reading.length-1}:null;}const b=rec('book').find(b=>b.status==='reading');return b?{id:b.id,title:b.title,author:b.author,page:b.page||0,pages:b.pages,more:0}:null;}
 function readingWidget(){const c=catalog(),book=currentReading(),timer=get('timer','reading-timer');const link=c.allowed?`<a class="text-button reading-link" href="./biblioteca.html">Ir a mi biblioteca ${icon('ArrowRight')}</a>`:`<button class="text-button reading-link" data-action="library">Ir a mi biblioteca ${icon('ArrowRight')}</button>`;return `<h3>${book?esc(book.title):'Una página, un nuevo mundo.'}</h3><p>${book?esc(book.author||'Tu lectura actual'):c.allowed?'Cuando empieces un libro en tu biblioteca, va a aparecer acá.':'Guardá tus libros y disfrutá de un ratito de lectura.'}</p>${book?`<div class="book-progress"><span>Página ${book.page} de ${book.pages||'—'}${book.more>0?` · y ${book.more} ${book.more===1?'libro más':'libros más'}`:''}</span><progress value="${book.page}" max="${book.pages||100}"></progress></div>`:''}${timer?`<div class="timer-display" data-timer>${fmtDuration(elapsed(timer))}</div><div class="button-row">${btn(icon(timer.running?'Pause':'Play')+(timer.running?'Pausar':'Seguir'),'timer-toggle','','button outline')}${btn(icon('Square')+'Terminar','timer-stop','','button primary')}</div>`:btn(icon('Play')+'Mi momento de lectura','timer-start','','button outline wide')}${link}`;}
 function calendarView(){if(window.calendarMode==='week')return `${heading('TU SEMANA','Tu calendario','Una vista de tus horarios.',btn('Ver mes','calendar-mode','data-mode="month"','button outline'))}<div class="button-row">${btn('Semana anterior','week-step','data-step="-7"','button outline')}${btn('Hoy','calendar-today','','button outline')}${btn('Semana siguiente','week-step','data-step="7"','button outline')}${btn('Agregar evento','new-event','','button primary')}</div><div class="week-agenda">${weekKeys(date).map(d=>`<section><h3>${prettyDate(d,{weekday:'short',day:'numeric',month:'short'})}</h3>${rec('event').filter(e=>occurs(e,d)).map(e=>eventOnDate(e,d)).sort((a,b)=>(a.time||'').localeCompare(b.time||'')).map(e=>eventCard(e,d)).join('')||'<p class="muted">Sin eventos</p>'}</section>`).join('')}</div>`;const first=parseDay(month+'-01'),offset=(first.getDay()+6)%7,gridStart=addDays(dayKey(first),-offset),selected=rec('event').filter(e=>occurs(e,date)).sort((a,b)=>(a.time||'').localeCompare(b.time||''));return `${heading('HACÉ ESPACIO PARA TUS PLANES','Tu calendario','Tus compromisos y tus momentos, en equilibrio.',btn(icon('Plus')+'Nuevo evento','new-event','','button primary'))}<div class="calendar-layout"><section class="panel calendar-panel"><div class="calendar-toolbar">${btn('Ver semana','calendar-mode','data-mode="week"','button outline')}<h2>${first.toLocaleDateString('es-PY',{month:'long',year:'numeric'})}</h2><div class="button-row">${btn('Hoy','calendar-today','','button outline')}${btn(icon('ChevronLeft'),'month','data-step="-1" aria-label="Mes anterior"','icon-button')}${btn(icon('ChevronRight'),'month','data-step="1" aria-label="Mes siguiente"','icon-button')}</div></div><div class="calendar-grid">${['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'].map(d=>`<div class="weekday">${d}</div>`).join('')}${Array.from({length:42},(_,i)=>{const d=addDays(gridStart,i),ev=rec('event').filter(e=>occurs(e,d)),st=dayStats(rec('habit'),rec('log'),d);return `<button class="calendar-cell ${d.slice(0,7)!==month?'outside':''} ${d===date?'selected':''} ${d===dayKey()?'current':''}" data-action="date" data-date="${d}"><span>${parseDay(d).getDate()}</span><div class="calendar-events">${ev.slice(0,2).map(e=>`<small style="--area:${safeColor(area(e.area).color)}">${esc(e.name)}</small>`).join('')}${ev.length>2?`<small>+${ev.length-2} más</small>`:''}</div>${st.done?`<b class="calendar-progress">${st.done} ✓</b>`:''}</button>`;}).join('')}</div></section><aside><section class="panel"><p class="eyebrow">${prettyDate(date,{weekday:'long'})}</p><h2>${prettyDate(date,{day:'numeric',month:'long'})}</h2><div class="agenda-list">${selected.map(e=>eventCard(e,date)).join('')||empty('Este día todavía no tiene eventos.')}</div>${btn(icon('Plus')+'Agregar evento','new-event','','button outline wide')}</section><section class="panel day-history"><h3>Hábitos de este día</h3>${rec('habit').filter(h=>scheduled(h,date)).map(h=>{const l=rec('log').find(l=>l.habitId===h.id&&l.date===date);return `<button class="history-row" data-action="habit-action" data-id="${h.id}" data-date="${date}">${icon(l?.status==='done'?'CheckCircle2':h.icon)}<span>${esc(h.name)}</span><small>${l?.status==='done'?'Hecho':l?.status==='skip'?'Pausa':'Pendiente'}</small></button>`;}).join('')||'<p class="muted">No hay hábitos programados.</p>'}</section></aside></div>`;}
-function areasView(){const a=areaFilter?area(areaFilter):null;return `${heading('LO QUE IMPORTA EN TU VIDA',a?esc(a.name):'Mis áreas','Un lugar para cada parte de vos.',btn(icon('Plus')+'Nueva área','new-area','','button primary'))}<div class="chips area-filters">${btn('Todas','area','data-id=""',!a?'chip selected':'chip')}${areas().map(x=>btn(icon(x.icon)+esc(x.name),'area',`data-id="${x.id}"`,x.id===areaFilter?'chip selected':'chip')).join('')}</div>${!a?`<div class="areas-grid">${areas().map(x=>`<button class="area-tile" style="--area:${safeColor(x.color)}" data-action="area" data-id="${x.id}"><span class="habit-icon">${icon(x.icon)}</span><h2>${esc(x.name)}</h2><p>${rec('habit').filter(h=>h.area===x.id&&!h.archived).length} hábitos · ${rec('task').filter(t=>t.area===x.id&&!t.done).length} pendientes</p>${icon('ArrowUpRight')}</button>`).join('')}</div>`:`<div class="button-row area-tools">${btn(icon('Plus')+'Hábito','new-habit','','button outline')}${btn(icon('Plus')+'Tarea','new-task','','button outline')}${btn(icon('Settings')+'Editar área','edit-area',`data-id="${a.id}"`,'button outline')}</div>${a.id==='lectura'?libraryView():a.id==='ingles'?vocabView():''}<div class="section-title"><h2>Hábitos de ${esc(a.name)}</h2></div><div class="habit-grid">${rec('habit').filter(h=>h.area===a.id&&!h.archived).map(h=>habitCard(h,dayKey())).join('')||empty('Agregá tu primer hábito para esta área.','new-habit')}</div><div class="section-title"><h2>Pendientes</h2></div>${taskList(rec('task').filter(t=>t.area===a.id))}`}`;}
+function upcomingForArea(areaId,days=60,limit=12){const out=[],start=dayKey();for(let i=0;i<days&&out.length<limit;i++){const d=addDays(start,i);for(const e of rec('event'))if(e.area===areaId&&occurs(e,d)){out.push({d,e:eventOnDate(e,d)});if(out.length>=limit)break;}}return out;}
+function areaAgenda(a){const items=upcomingForArea(a.id);return `<div class="section-title"><div><h2>Próximos en tu agenda</h2><p>Eventos de ${esc(a.name)} de los próximos dos meses.</p></div>${btn(icon('Plus')+'Evento','new-event','','text-button')}</div>${items.length?`<section class="panel area-agenda">${items.map(({d,e})=>{const n=Math.round((parseDay(d)-parseDay(dayKey()))/86400000);return `<div class="area-agenda-day"><small>${d===dayKey()?'Hoy':n===1?'Mañana':prettyDate(d,{weekday:'short',day:'numeric',month:'short'})+` · en ${n} días`}</small>${eventCard(e,d)}</div>`;}).join('')}</section>`:empty(`No tenés eventos de ${esc(a.name)} en los próximos dos meses.`,'new-event','Agregar evento')}`;}
+function areasView(){const a=areaFilter?area(areaFilter):null;return `${heading('LO QUE IMPORTA EN TU VIDA',a?esc(a.name):'Mis áreas','Un lugar para cada parte de vos.',btn(icon('Plus')+'Nueva área','new-area','','button primary'))}<div class="chips area-filters">${btn('Todas','area','data-id=""',!a?'chip selected':'chip')}${areas().map(x=>btn(icon(x.icon)+esc(x.name),'area',`data-id="${x.id}"`,x.id===areaFilter?'chip selected':'chip')).join('')}</div>${!a?`<div class="areas-grid">${areas().map(x=>`<button class="area-tile" style="--area:${safeColor(x.color)}" data-action="area" data-id="${x.id}"><span class="habit-icon">${icon(x.icon)}</span><h2>${esc(x.name)}</h2><p>${rec('habit').filter(h=>h.area===x.id&&!h.archived).length} hábitos · ${rec('task').filter(t=>t.area===x.id&&!t.done).length} pendientes${(n=>n?` · ${n} ${n===1?'evento próximo':'eventos próximos'}`:'')(upcomingForArea(x.id).length)}</p>${icon('ArrowUpRight')}</button>`).join('')}</div>`:`<div class="button-row area-tools">${btn(icon('Plus')+'Hábito','new-habit','','button outline')}${btn(icon('Plus')+'Tarea','new-task','','button outline')}${btn(icon('Settings')+'Editar área','edit-area',`data-id="${a.id}"`,'button outline')}</div>${a.id==='lectura'?libraryView():a.id==='ingles'?vocabView():''}${areaAgenda(a)}<div class="section-title"><h2>Hábitos de ${esc(a.name)}</h2></div><div class="habit-grid">${rec('habit').filter(h=>h.area===a.id&&!h.archived).map(h=>habitCard(h,dayKey())).join('')||empty('Agregá tu primer hábito para esta área.','new-habit')}</div><div class="section-title"><h2>Pendientes</h2></div>${taskList(rec('task').filter(t=>t.area===a.id))}`}`;}
 function spaceView(){const tabs=[['diario','Mi diario'],['tareas','Pendientes'],['biblioteca','Biblioteca'],['proyectos','Proyectos'],['planning','Estudio y trabajo'],['progreso','Mi progreso']];return `${heading('TU HISTORIA, PASO A PASO','Mi espacio','Ideas, lecturas y logros que querés guardar.')}<div class="chips space-tabs">${tabs.map(([id,name])=>btn(name,'space-tab',`data-tab="${id}"`,tab===id?'chip selected':'chip')).join('')}</div>${tab==='planning'?planningView({esc,btn}):tab==='biblioteca'?libraryView():tab==='progreso'?progressView():tab==='tareas'?`<div class="section-title"><h2>Una cosa a la vez</h2>${btn(icon('Plus')+'Nueva tarea','new-task','','button primary')}</div>${taskList(rec('task'))}`:tab==='proyectos'?projectsView():journalView()}`;}
 function taskList(tasks){return `<div class="task-list">${tasks.sort((a,b)=>Number(a.done)-Number(b.done)||(a.due||'9999').localeCompare(b.due||'9999')).map(t=>`<article class="task-row ${t.done?'completed':''}">${btn(icon(t.done?'CheckCircle2':'Check'),'task-done',`data-id="${t.id}" aria-label="${t.done?'Reabrir':'Completar'} tarea"`,'icon-button')}<button class="task-main" data-action="edit-task" data-id="${t.id}"><strong>${esc(t.name)}</strong><small>${esc(area(t.area).name)} ${t.projectId?' · '+esc(get('project',t.projectId)?.name||''):''}${t.due?' · '+prettyDate(t.due,{day:'numeric',month:'short'}):' · Para después'}</small></button><span class="priority ${t.priority==='alta'?'high':''}">${t.priority==='alta'?'Alta':t.priority==='baja'?'Baja':'Media'}</span>${t.due<dayKey()&&!t.done?'<span class="overdue">Vencida</span>':''}</article>`).join('')||empty('Lo pendiente puede empezar con una pequeña tarea.','new-task','Crear tarea')}</div>`;}
 function catalogReadingCards(){const c=catalog();return c.reading.map(b=>`<article class="book-card"><a class="book-cover" href="./biblioteca.html"><span>${icon('BookOpen')}</span><h3>${esc(b.titulo)}</h3><small>${esc(b.autor||'')}</small></a><div class="book-details"><span class="tag">${b.estado_lectura==='releyendo'?'Releyendo':'Leyendo'}</span><h3>${esc(b.titulo)}</h3><p>${esc(b.autor||'Sin autor registrado')}</p><progress max="${b.paginas||100}" value="${b.pagina_actual||0}"></progress><small>${b.pagina_actual||0} / ${b.paginas||'—'} páginas</small></div></article>`).join('')||empty('Cuando empieces un libro en tu biblioteca, va a aparecer acá.');}
diff --git a/src/style.css b/src/style.css
index 57ca27f..9d2dba8 100644
--- a/src/style.css
+++ b/src/style.css
@@ -12,3 +12,5 @@
 @media(max-width:760px){.mobile-nav button{min-width:0;flex:1}.mobile-nav button span{font-size:9px}}
 .icon-picker{display:flex;flex-wrap:wrap;gap:6px;grid-column:1/-1}.icon-picker label{display:block}.icon-picker input{position:absolute;opacity:0;width:1px;height:1px}.icon-picker span{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);border-radius:10px}.icon-picker input:checked+span{background:var(--soft);border:2px solid var(--green)}.icon-picker input:focus-visible+span{outline:3px solid var(--accent)}
 .week-agenda{display:grid;grid-template-columns:repeat(7,minmax(150px,1fr));overflow-x:auto;gap:12px}.week-agenda>section{padding:12px;background:var(--panel);border:1px solid var(--line);border-radius:12px}.week-agenda h3{font-size:13px}
+
+.area-agenda{padding:18px 22px}.area-agenda-day{padding:10px 0;border-bottom:1px solid var(--line)}.area-agenda-day:last-child{border:0}.area-agenda-day>small{display:block;font-size:10px;color:var(--muted);margin-bottom:6px;text-transform:capitalize}.area-agenda .event-card{margin-bottom:0}
